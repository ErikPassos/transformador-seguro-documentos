# Ambiente virtual
.venv/
venv/
env/

# Cache e arquivos compilados do Python
__pycache__/
*.py[cod]
*$py.class

# Compilação do PyInstaller
build/
dist/
*.spec.bak

# Arquivos gerados pelo aplicativo
saida/*
!saida/.gitkeep

temporarios/*
!temporarios/.gitkeep

logs/
*.log

# PDFs inseridos pelo usuário
entrada/*
!entrada/.gitkeep

# Planilhas geradas
*.xlsx
*.xls

# Executáveis e instaladores
*.exe
instalador/

# Arquivos do Windows e macOS
Thumbs.db
Desktop.ini
.DS_Store

# Configurações locais do VS Code
.vscode/

# Variáveis de ambiente e segredos
.env
.env.*
*.key
*.pem
# Pacote temporário usado na preparação do instalador
arquivos_instalador/

# Arquivos compactados
*.zip